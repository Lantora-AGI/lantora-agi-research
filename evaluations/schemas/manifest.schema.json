{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantora-agi.github.io/schemas/manifest.schema.json",
  "title": "Lantora evaluation run manifest",
  "type": "object",
  "required": ["schema_version", "harness_version", "repository_commit", "started_at", "ended_at", "duration_seconds", "seed", "adapter", "environment", "task_count", "tasks", "results_sha256", "retries", "exclusions"],
  "properties": {
    "schema_version": {"type": "string"},
    "harness_version": {"type": "string"},
    "repository_commit": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "seed": {"type": "integer"},
    "adapter": {"type": "object"},
    "environment": {"type": "object"},
    "task_count": {"type": "integer", "minimum": 1},
    "tasks": {"type": "array", "minItems": 1},
    "results_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retries": {"type": "integer", "minimum": 0},
    "exclusions": {"type": "array"}
  }
}

